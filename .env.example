NODE_ENV=development
PORT=8080
APP_TIMEZONE=Asia/Jakarta
SCHEDULER_INTERVAL_SECONDS=10
SCHEDULER_BATCH_SIZE=10
SCHEDULER_LOCK_TIMEOUT_MINUTES=5

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=waha_reminder
MYSQL_USER=waha_reminder
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

WAHA_URL=http://waha:3000
WAHA_API_KEY=replace-with-a-long-random-api-key
WAHA_SESSION=default
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

